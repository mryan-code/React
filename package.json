    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "any-uri-scheme-webpack-plugin": "^1.0.2",
    "assert": "^2.1.0",
    "axios": "^1.18.1",
    "buffer": "^6.0.3",
    "core-js": "^3.49.0",
    "fs": "^0.0.1-security",
    "googleapis": "^173.0.0",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "https-browserify": "^1.0.0",
    "lucide-react": "^1.41.0",
    "material-design-icons-iconfont": "^6.7.0",
    "moment-timezone": "^0.6.2",
    "net": "^1.0.2",
    "os": "^0.1.2",
    "os-browserify": "^0.3.0",
    "path": "^0.12.7",
    "process": "^0.11.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "three": "^0.185.1",
    "tls": "^0.0.1",
    "url": "^0.11.4",
    "vite-plugin": "^0.0.0",
    "vm-browserify": "^1.1.2",
    "ws": "^8.21.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cypress": "^15.21.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "selenium-webdriver": "^4.45.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "cross-spawn": "7.0.6",
    "js-yaml": "4.2.0",
    "postcss": "8.5.15",
    "serialize-javascript": "7.0.6",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.5"
  },
  "eslintConfig": {
    "root": true,
    "env": {
